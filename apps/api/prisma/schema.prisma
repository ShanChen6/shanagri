generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Farm {
  id String @id
  name String
  pumps Pump[]
}
model Pump {
  flowMlPerSecond Int @default(100)
  irrigation Irrigation[]
  id String @id
  name String
  farmId String
  farm Farm @relation(fields: [farmId], references: [id])
  zones Zone[]
}
model PlantProfile {
  id String @id
  name String
  dryBelowPct Int
  zones Zone[]
}
model Zone {
  irrigation Irrigation[]
  simulatedDays SimulatedDay[]
  id String @id
  name String
  pumpId String
  pump Pump @relation(fields: [pumpId], references: [id])
  plantProfileId String
  plantProfile PlantProfile @relation(fields: [plantProfileId], references: [id])
}

model SimulatedDay {
  zoneId String
  scenario String
  simulatedDate DateTime @db.Date
  moisturePct Int
  needsWater Boolean
  zone Zone @relation(fields: [zoneId], references: [id])
  @@id([zoneId, scenario, simulatedDate])
}

model Irrigation {
  startedAt DateTime? @db.Timestamptz
  flowMlPerSecond Int?
  estimatedMl BigInt?
  @@index([zoneId,status,finishAt],map:"irrigation_history")
  id Int @id @default(autoincrement())
  pumpId String
  zoneId String
  source String
  status String @default("PENDING")
  finishAt DateTime? @db.Timestamptz
  pump Pump @relation(fields:[pumpId], references:[id])
  zone Zone @relation(fields:[zoneId], references:[id])
  @@index([pumpId,status,id],map:"irrigation_fifo")
}
